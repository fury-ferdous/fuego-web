# Basis-URL der Produktivseite (fuer Sitemap, Canonicals, Schema)
NEXT_PUBLIC_SITE_URL=https://fuego.at

# ---------------------------------------------------------------- RESERVIERUNG
# Drei Varianten, eine davon waehlen.
#
# A) Formular sendet direkt an das PHP-Skript auf dem Webspace.
#    Einfachste Loesung, wenn fuego.at ohnehin PHP-Hosting hat.
#    Die Domain muss in reservierung.php unter $ALLOWED_ORIGINS stehen.
# NEXT_PUBLIC_RESERVATION_ENDPOINT=https://fuego.at/mail/reservierung.php
#
# B) Next.js leitet serverseitig an das PHP-Skript weiter.
#    Die Skript-Adresse bleibt dabei im Quelltext unsichtbar.
# RESERVATION_PHP_ENDPOINT=https://fuego.at/mail/reservierung.php
#
# C) Weiterleitung an einen Webhook (Make, Zapier, n8n, eigener Endpoint).
# RESERVATION_WEBHOOK_URL=

# Ist nichts gesetzt, zeigt das Formular einen vorausgefuellten E-Mail-Entwurf
# an office@fuego.at und dugicalko@gmail.com. Es wird niemals "gesendet"
# gemeldet, ohne dass tatsaechlich etwas gesendet wurde.
